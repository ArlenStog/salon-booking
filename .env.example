# Leave DATABASE_URL empty locally: the app then runs an embedded Postgres (PGlite) in ./.pglite
# On Vercel, set it to your Neon / Vercel Postgres connection string.
DATABASE_URL=

# Optional: creates (or promotes) an admin account on startup.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: enables the "Describe what you want" AI booking box.
ANTHROPIC_API_KEY=
